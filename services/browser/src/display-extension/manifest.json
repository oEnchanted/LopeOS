{
  "manifest_version": 3,
  "name": "Lope Browser display",
  "description": "Shows the selected tab in LopeOS. Only the Lope Browser worker drives it, over its private DevTools pipe.",
  "version": "1.0.0",
  "minimum_chrome_version": "134",
  "key": "",
  "permissions": [
    "tabCapture",
    "offscreen",
    "debugger",
    "clipboardRead",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
